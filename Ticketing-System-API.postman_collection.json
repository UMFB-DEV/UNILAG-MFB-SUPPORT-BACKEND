				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    if (response.data.user.role === 'admin') {",
									"        pm.collectionVariables.set('adminToken', response.data.token);",
									"    } else if (response.data.user.role === 'agent') {",
									"        pm.collectionVariables.set('agentToken', response.data.token);",
									"    } else {",
									"        pm.collectionVariables.set('userToken', response.data.token);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"password123\",\n    \"role\": \"admin\",\n    \"department\": \"IT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Register a new user. Can be admin, agent, or user role"
